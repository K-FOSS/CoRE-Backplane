{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "dhcp": {
      "type": "object",
      "required": ["dhcp4", "dhcp6"],
      "properties": {
        "dhcp4": {
          "type": "object",
          "required": ["shared-networks"],
          "properties": {
            "client-classes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": {"type": "string", "minLength": 1}
                }
              }
            },
            "shared-networks": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/definitions/sharedNetwork"}
            },
            "subnet4": {
              "type": "array",
              "items": {"$ref": "#/definitions/subnet4"}
            }
          }
        },
        "dhcp6": {
          "type": "object",
          "required": ["subnet6"],
          "properties": {
            "subnet6": {
              "type": "array",
              "items": {"$ref": "#/definitions/subnet6"}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "ipv4": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)$"
    },
    "cidr4": {
      "type": "string",
      "pattern": "^((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/(3[0-2]|[12]?[0-9])$"
    },
    "mac": {
      "type": "string",
      "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"
    },
    "cidr6": {
      "type": "string",
      "pattern": "^[0-9A-Fa-f:]+/(12[0-8]|1[01][0-9]|[1-9]?[0-9])$"
    },
    "pool": {
      "type": "object",
      "required": ["pool"],
      "properties": {
        "pool": {
          "type": "string",
          "pattern": "^(((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)/(3[0-2]|[12]?[0-9])|((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?) - ((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?))$"
        }
      }
    },
    "reservation": {
      "type": "object",
      "required": ["ip-address"],
      "properties": {
        "ip-address": {"$ref": "#/definitions/ipv4"},
        "hw-address": {"$ref": "#/definitions/mac"},
        "hostname": {"type": "string", "minLength": 1},
        "client-id": {"type": "string", "minLength": 1},
        "duid": {"type": "string", "minLength": 1},
        "circuit-id": {"type": "string", "minLength": 1},
        "flex-id": {"type": "string", "minLength": 1}
      },
      "anyOf": [
        {"required": ["hw-address"]},
        {"required": ["client-id"]},
        {"required": ["duid"]},
        {"required": ["circuit-id"]},
        {"required": ["flex-id"]}
      ]
    },
    "subnet4": {
      "type": "object",
      "required": ["id", "subnet"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "subnet": {"$ref": "#/definitions/cidr4"},
        "pools": {
          "type": "array",
          "items": {"$ref": "#/definitions/pool"}
        },
        "reservations": {
          "type": "array",
          "items": {"$ref": "#/definitions/reservation"}
        },
        "option-data": {"type": "array"}
      }
    },
    "sharedNetwork": {
      "type": "object",
      "required": ["name", "subnet4"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "subnet4": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/subnet4"}
        },
        "relay": {
          "type": "object",
          "properties": {
            "ip-addresses": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/definitions/ipv4"}
            }
          }
        },
        "option-data": {"type": "array"}
      }
    },
    "pool6": {
      "type": "object",
      "required": ["pool"],
      "properties": {
        "pool": {"$ref": "#/definitions/cidr6"}
      }
    },
    "pdPool6": {
      "type": "object",
      "required": ["prefix", "prefix-len", "delegated-len"],
      "properties": {
        "prefix": {"type": "string", "pattern": "^[0-9A-Fa-f:]+$"},
        "prefix-len": {"type": "integer", "minimum": 1, "maximum": 127},
        "delegated-len": {"type": "integer", "minimum": 2, "maximum": 128}
      }
    },
    "subnet6": {
      "type": "object",
      "required": ["id", "subnet"],
      "properties": {
        "id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "subnet": {"$ref": "#/definitions/cidr6"},
        "pools": {
          "type": "array",
          "items": {"$ref": "#/definitions/pool6"}
        },
        "pd-pools": {
          "type": "array",
          "items": {"$ref": "#/definitions/pdPool6"}
        },
        "reservations": {"type": "array"},
        "option-data": {"type": "array"}
      }
    }
  }
}
